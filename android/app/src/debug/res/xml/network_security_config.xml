<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so a phone on the same Wi-Fi can reach a test
     backend on a laptop (e.g. http://192.168.1.20:8080/). Release builds use the strict
     config in src/main. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
