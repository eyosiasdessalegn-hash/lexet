<?xml version="1.0" encoding="utf-8"?>
<!-- Back up bookmarks, tags and settings; the item archive itself is re-synced. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="lexet.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lexet.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
